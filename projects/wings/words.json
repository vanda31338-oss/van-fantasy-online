[{"text": "ถ้าจู่ๆ", "start": 0.077, "end": 0.561}, {"text": "ทุกคนมีปีกบินได้", "start": 0.588, "end": 2.081}, {"text": "แต่แอปยังเด้งออเดอร์ให้ไปส่ง...", "start": 2.121, "end": 3.841}, {"text": "จะรอดไหม?", "start": 4.001, "end": 4.921}, {"text": "ต้น", "start": 5.201, "end": 5.441}, {"text": "ไรเดอร์ชุดเขียว", "start": 5.681, "end": 6.721}, {"text": "รอออเดอร์อยู่หน้าห้าง", "start": 6.881, "end": 8.081}, {"text": "คนแน่นเอี้ยด", "start": 8.401, "end": 9.601}, {"text": "จู่ๆ", "start": 9.681, "end": 10.081}, {"text": "ฟ้าก็สว่างวาบ", "start": 10.161, "end": 11.521}, {"text": "เมฆแหวกออกเป็นรูวงกลม", "start": 11.601, "end": 13.441}, {"text": "ทูตสวรรค์ปีกหกแฉก", "start": 13.521, "end": 14.881}, {"text": "ตัวใหญ่เท่าตึก", "start": 14.961, "end": 16.081}, {"text": "ลอยลงมา", "start": 16.241, "end": 17.201}, {"text": "นางชี้นิ้วลงมาทีเดียว", "start": 17.361, "end": 18.881}, {"text": "แสงทองก็ตกใส่ทุกคน", "start": 18.961, "end": 20.801}, {"text": "ทุกคนงอกปีกออกมาพร้อมกัน", "start": 20.881, "end": 22.881}, {"text": "สีไม่ซ้ำกันเลย", "start": 22.961, "end": 24.241}, {"text": "แต่ปีกต้นใหญ่สุด", "start": 24.321, "end": 25.601}, {"text": "สีทองเรืองแสง", "start": 25.681, "end": 26.961}, {"text": "เหมือนตัวเอกในเกม", "start": 27.041, "end": 28.241}, {"text": "แต่ไม่มีใครบินเป็น", "start": 28.321, "end": 29.761}, {"text": "สองคนกระพือขึ้นไป", "start": 29.921, "end": 31.361}, {"text": "ชนกันกลางอากาศ", "start": 31.441, "end": 32.801}, {"text": "ลุงอีกคนปีกไปพันสายไฟ", "start": 32.881, "end": 34.721}, {"text": "โดนไฟช็อตจนผมตั้ง", "start": 34.801, "end": 36.561}, {"text": "คนขับรถทิ้งพวงมาลัยบินหนี", "start": 36.641, "end": 38.721}, {"text": "รถพุ่งชนเสาไฟ", "start": 38.801, "end": 40.241}, {"text": "ไฟลุกทั้งถนน", "start": 40.401, "end": 41.521}, {"text": "ทั้งเมืองกรี๊ด", "start": 41.601, "end": 42.641}, {"text": "ร้องไห้", "start": 42.721, "end": 43.441}, {"text": "วิ่งกันมั่วไปหมด", "start": 43.521, "end": 44.721}, {"text": "แล้วมือถือต้นก็เด้ง!", "start": 44.761, "end": 46.508}, {"text": "ข้าวมันไก่", "start": 46.534, "end": 47.201}, {"text": "ส่งคอนโดชั้นสามสิบ", "start": 47.281, "end": 48.881}, {"text": "ใครมีเพื่อนเป็นไรเดอร์", "start": 49.001, "end": 50.241}, {"text": "แชร์ให้ดูเลย", "start": 50.321, "end": 51.361}, {"text": "ถนนตันเพราะรถชนกันหมด", "start": 51.441, "end": 53.201}, {"text": "ต้นเลยกางปีกบินไปส่ง", "start": 53.281, "end": 54.961}, {"text": "หลบคนบินสวนเลน", "start": 55.041, "end": 56.401}, {"text": "มุดใต้สายไฟ", "start": 56.441, "end": 57.521}, {"text": "ฝ่าควันไฟไหม้", "start": 57.601, "end": 58.761}, {"text": "ถึงชั้นสามสิบ", "start": 58.801, "end": 60.081}, {"text": "ลูกค้าเปิดหน้าต่างมาเจอ", "start": 60.161, "end": 61.601}, {"text": "กรี๊ดลั่น", "start": 61.681, "end": 62.401}, {"text": "นึกว่าโจร", "start": 62.481, "end": 63.361}, {"text": "ทั้งที่ตัวเองก็มีปีก", "start": 63.441, "end": 65.001}, {"text": "บินลงไปเอาเองก็ได้", "start": 65.041, "end": 66.401}, {"text": "ได้ค่าส่งห้าสิบบาท", "start": 66.481, "end": 68.001}, {"text": "แล้วโดนปิดหน้าต่างใส่หน้า", "start": 68.081, "end": 69.761}, {"text": "ปึง!", "start": 69.801, "end": 70.521}, {"text": "ต้นบินกลับที่เดิม", "start": 70.561, "end": 71.921}, {"text": "ยิ้มทั้งน้ำตา", "start": 72.001, "end": 73.121}, {"text": "แล้วถามตัวเองว่า", "start": 73.201, "end": 74.561}]