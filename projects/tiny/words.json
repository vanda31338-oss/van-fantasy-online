[{"text": "ถ้าตื่นมาแล้วตัวหดเหลือสองเซน", "start": 0.081, "end": 2.081}, {"text": "ต้องอยู่ในห้องตัวเองให้รอดยี่สิบสี่ชั่วโมง...", "start": 2.321, "end": 4.641}, {"text": "จะรอดไหม?", "start": 4.801, "end": 5.681}, {"text": "ต้นลืมตาบนหมอน", "start": 5.921, "end": 7.121}, {"text": "ที่ตอนนี้กว้างเท่าครึ่งสนามฟุตบอล", "start": 7.201, "end": 9.601}, {"text": "ชั่วโมงแรก", "start": 9.681, "end": 10.561}, {"text": "แค่ลงจากเตียงก็เหมือนโดดตึกสิบสองชั้น", "start": 10.641, "end": 13.281}, {"text": "แต่ตัวเล็กขนาดนี้", "start": 13.361, "end": 14.561}, {"text": "อากาศต้านจนตกช้า", "start": 14.801, "end": 16.241}, {"text": "ต้นเลยรอดแบบงงๆ", "start": 16.321, "end": 18.001}, {"text": "ชั่วโมงที่สาม", "start": 18.081, "end": 19.121}, {"text": "หิวมาก", "start": 19.281, "end": 20.241}, {"text": "เจอข้าวสวยเม็ดเดียว", "start": 20.361, "end": 21.441}, {"text": "ใหญ่เท่าหมอนหนุน", "start": 21.521, "end": 22.721}, {"text": "กำลังกินอร่อย", "start": 22.801, "end": 23.921}, {"text": "พัดลมก็ส่ายมา", "start": 24.001, "end": 25.361}, {"text": "ลมแรงเหมือนพายุเข้า", "start": 25.521, "end": 26.961}, {"text": "ปลิวไปตกกลางแถวมดแดง", "start": 27.041, "end": 28.561}, {"text": "ที่ตัวใหญ่เท่าหมาโกลเด้น", "start": 28.641, "end": 30.401}, {"text": "มดนึกว่าเป็นเศษขนม", "start": 30.561, "end": 31.921}, {"text": "เลยช่วยกันแบกต้นกลับรังซะงั้น", "start": 32.001, "end": 34.241}, {"text": "ชั่วโมงที่สิบสอง", "start": 34.321, "end": 35.441}, {"text": "ต้นดิ้นหลุดมาได้", "start": 35.521, "end": 36.801}, {"text": "แต่แล้ว...", "start": 36.881, "end": 37.641}, {"text": "แมวก็ตื่น", "start": 37.681, "end": 38.721}, {"text": "ใครเลี้ยงแมว", "start": 38.801, "end": 39.521}, {"text": "แชร์ให้ดูหน่อย", "start": 39.601, "end": 40.401}, {"text": "ว่าน้องจะทำแบบนี้ไหม", "start": 40.481, "end": 42.001}, {"text": "ต้นวิ่งสุดชีวิต", "start": 42.081, "end": 43.201}, {"text": "มุดเข้าใต้สายรองเท้าแตะ", "start": 43.241, "end": 44.881}, {"text": "แมวตะปบพลาดไปนิดเดียว", "start": 44.961, "end": 46.961}, {"text": "ชั่วโมงที่สิบแปด", "start": 47.121, "end": 48.241}, {"text": "ฝนตก", "start": 48.321, "end": 48.961}, {"text": "หลังคารั่ว", "start": 49.001, "end": 50.081}, {"text": "น้ำหยดใหญ่เท่าลูกบอลชายหาด", "start": 50.161, "end": 52.161}, {"text": "ห้องกลายเป็นทะเล", "start": 52.241, "end": 53.601}, {"text": "ต้นเลยกระโดดขึ้นฝาขวด", "start": 53.681, "end": 55.201}, {"text": "ล่องเรือกลางห้อง", "start": 55.281, "end": 56.641}, {"text": "ชั่วโมงที่ยี่สิบสาม", "start": 56.721, "end": 58.001}, {"text": "แม่เปิดประตูเข้ามา...", "start": 58.161, "end": 59.561}, {"text": "พร้อมไม้กวาด", "start": 59.601, "end": 60.721}, {"text": "ต้นโดนกวาดลงที่ตักขยะ", "start": 60.801, "end": 62.321}, {"text": "ไปพร้อมฝุ่นทั้งห้อง", "start": 62.401, "end": 63.921}, {"text": "ครบยี่สิบสี่ชั่วโมงพอดี", "start": 64.001, "end": 65.721}, {"text": "ตัวกลับมาเท่าเดิม", "start": 65.761, "end": 66.961}, {"text": "แต่อยู่ในถังขยะหน้าบ้าน", "start": 67.041, "end": 68.801}, {"text": "แม่ยืนงง", "start": 68.881, "end": 69.961}, {"text": "ต้นยิ้มแห้งๆ", "start": 70.001, "end": 71.241}, {"text": "แล้วสงสัยว่า", "start": 71.281, "end": 72.561}]